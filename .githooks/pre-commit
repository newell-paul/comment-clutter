#!/usr/bin/env python3
"""why: reject AI commits that add comment lines without a 'why:' prefix.

Runs only when the commit happens inside an AI coding session (CLAUDECODE or
AI_AGENT set). Human commits are untouched. Reuses the marker table from the
Claude Code write-time hook so both gates agree on what a comment is.
"""

import importlib.util
import os
import subprocess
import sys

if not (os.environ.get("CLAUDECODE") or os.environ.get("AI_AGENT")):
    sys.exit(0)

ROOT = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True).stdout.strip()
spec = importlib.util.spec_from_file_location("gate", os.path.join(ROOT, ".claude/hooks/no-new-comments.py"))
gate = importlib.util.module_from_spec(spec)
spec.loader.exec_module(gate)

diff = subprocess.run(
    ["git", "diff", "--cached", "-U0", "--diff-filter=AM", "--no-color"],
    capture_output=True, text=True, check=True,
).stdout

offenders: dict[str, list[str]] = {}
path, markers = None, None
for line in diff.splitlines():
    if line.startswith("+++ b/"):
        path = line[6:]
        markers = gate.MARKERS.get(os.path.splitext(path)[1])
    elif markers and line.startswith("+") and not line.startswith("+++"):
        if gate.comment_lines(line[1:], markers):
            offenders.setdefault(path, []).append(line[1:].strip())

if not offenders:
    sys.exit(0)

print("pre-commit: AI session added comment lines without a 'why:' prefix:", file=sys.stderr)
for p, lines in offenders.items():
    for c in lines:
        print(f"  {p}: {c}", file=sys.stderr)
print("Say it in the code instead, or prefix the comment with 'why:' if it explains a non-obvious decision.", file=sys.stderr)
sys.exit(1)
